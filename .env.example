# 本番（Render）で設定する環境変数の一覧。ローカルでは何も設定しなくても動く
DB_HOST=
DB_PORT=4000
DB_USER=
DB_PASSWORD=
DB_NAME=wear_cast_db
DB_SSL=true
CLOUDINARY_URL=cloudinary://<api_key>:<api_secret>@<cloud_name>
# ログイン機能
# アプリのURL（最後の/はなし）。ローカルでは書かなくてよい（http://localhost:3000になる）
BASE_URL=https://<アプリ名>.onrender.com
# ログイン状態のCookieに署名するための長いランダムな文字列
# node -e "console.log(require('crypto').randomBytes(32).toString('hex'))" で作れる
SESSION_SECRET=
# Google Cloud ConsoleのOAuthクライアントID・シークレット（無いと「Googleでログイン」だけ使えない）
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
